    bathrooms: 2,
    image: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=600&auto=format&fit=crop&q=80',
    isFavorite: true,
  },
  {
    id: 'prop-3',
    title: 'Spacious 4-Bedroom Semi-Detached Duplex',
    location: 'Asokoro, Abuja',
    price: 25000000,
    bedrooms: 4,
    bathrooms: 5,
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&auto=format&fit=crop&q=80',
    isFavorite: false,
  },
  {
    id: 'prop-4',
    title: 'Cozy 1-Bedroom Studio',
    location: 'Gwarinpa, Abuja',
    price: 3200000,
    bedrooms: 1,
    bathrooms: 1,
    image: 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=600&auto=format&fit=crop&q=80',
    isFavorite: true,
  },
];

export default function App() {
  const [properties, setProperties] = useState(INITIAL_PROPERTIES);
  const [activeTab, setActiveTab] = useState('favorites'); // 'favorites' or 'all'

  // Toggle favorite status
  const handleToggleFavorite = (id) => {
    setProperties((prev) =>
      prev.map((item) =>
        item.id === id ? { ...item, isFavorite: !item.isFavorite } : item
      )
    );
  };

  // Filter listings based on active tab
  const displayedProperties =
    activeTab === 'favorites'
      ? properties.filter((p) => p.isFavorite)
      : properties;

  const favoriteCount = properties.filter((p) => p.isFavorite).length;

  return (
    <div style={styles.pageContainer}>
      <div style={styles.maxWidth}>
        {/* Top App Bar */}
        <header style={styles.header}>
          <div>
            <h1 style={styles.appTitle}>Homely Rentals</h1>
            <p style={styles.subtitle}>Find & bookmark your next rental home</p>
          </div>

          {/* Navigation Switcher */}
          <div style={styles.navBar}>
            <button
              onClick={() => setActiveTab('favorites')}
              style={{
                ...styles.tabButton,
                ...(activeTab === 'favorites' ? styles.activeTab : {}),
              }}
            >
              ❤️ My Favorites ({favoriteCount})
            </button>
            <button
              onClick={() => setActiveTab('all')}
              style={{
                ...styles.tabButton,
                ...(activeTab === 'all' ? styles.activeTab : {}),
              }}
            >
              🏠 All Listings ({properties.length})
            </button>
          </div>
        </header>

        {/* Status / Page Banner */}
        <div style={styles.banner}>
          <h2 style={styles.sectionTitle}>
            {activeTab === 'favorites' ? 'Saved Favorite Properties' : 'All Available Rentals'}
          </h2>
          <span style={styles.counterBadge}>
            Showing {displayedProperties.length} property(s)
          </span>
        </div>

        {/* Empty State */}
        {displayedProperties.length === 0 ? (
          <div style={styles.emptyCard}>
            <div style={styles.emptyIcon}>💔</div>
            <h3 style={styles.emptyTitle}>No favorite properties yet</h3>
            <p style={styles.emptyText}>
              You haven't saved any listings to your favorites list.
            </p>
            <button
              onClick={() => setActiveTab('all')}
              style={styles.browseButton}
            >
              Browse All Listings
            </button>
          </div>
        ) : (
          /* Property Cards Grid */
          <div style={styles.grid}>
            {displayedProperties.map((prop) => (
              <div key={prop.id} style={styles.card}>
                <div style={styles.imageWrapper}>
                  <img src={prop.image} alt={prop.title} style={styles.cardImage} />

                  {/* Favorite Heart Button */}
                  <button
                    onClick={() => handleToggleFavorite(prop.id)}
                    style={{
                      ...styles.heartButton,
                      color: prop.isFavorite ? '#ef4444' : '#9ca3af',
                    }}
                    title={prop.isFavorite ? 'Remove from favorites' : 'Add to favorites'}
                  >
                    ♥
                  </button>
                </div>

                <div style={styles.cardBody}>
                  <h3 style={styles.cardTitle}>{prop.title}</h3>
                  <p style={styles.cardLocation}>📍 {prop.location}</p>
                  
                  <div style={styles.priceRow}>
                    <span style={styles.priceAmount}>
                      ₦{prop.price.toLocaleString()}
                    </span>
                    <span style={styles.priceDuration}> / year</span>
                  </div>

                  <div style={styles.cardFooter}>
                    <span style={styles.specs}>
                      {prop.bedrooms} Bed • {prop.bathrooms} Bath
                    </span>
                    <button
                      onClick={() => handleToggleFavorite(prop.id)}
                      style={{
                        ...styles.quickActionBtn,
                        backgroundColor: prop.isFavorite ? '#fee2e2' : '#f3f4f6',
                        color: prop.isFavorite ? '#b91c1c' : '#374151',
                      }}
                    >
                      {prop.isFavorite ? 'Remove' : 'Save'}
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

